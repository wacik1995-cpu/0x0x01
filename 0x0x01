            LiveUpdateLabel.TextXAlignment = Enum.TextXAlignment.Left
            LiveUpdateLabel.Text = GlobalUpdateTextString -- Dynamic reference string update variable mapping hook
            applySlimTextStyle(LiveUpdateLabel, 14)
