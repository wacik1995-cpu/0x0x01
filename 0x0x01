local function applyMultiToneChat()
    task.spawn(function()
        local chatWindow = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
        local chatInput = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
        
        if chatWindow then
            chatWindow.BackgroundColor3 = CHAT_BLACK
            chatWindow.BackgroundTransparency = 0.15
            chatWindow.TextColor3 = CHAT_BRIGHT_PURPLE
        end
        if chatInput then
            chatInput.BackgroundColor3 = CHAT_DARK_PURPLE
            chatInput.BackgroundTransparency = 0.3
            chatInput.TextColor3 = CHAT_BRIGHT_PURPLE
        end
    end)

    task.spawn(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 5)
        if not playerGui then return end
        
        local chatGui = playerGui:WaitForChild("Chat", 3)
        if chatGui then
            local function RecurseAndColorChat(instance)
                if instance:IsA("Frame") or instance:IsA("ScrollingFrame") then
                    if instance.Name == "Frame" or instance.Name == "Background" then
                        instance.BackgroundColor3 = CHAT_BLACK
                    elseif instance.Name:find("Chat") or instance.Name:find("Message") then
                        instance.BackgroundColor3 = CHAT_DARK_PURPLE
                        instance.BackgroundTransparency = 0.5
                    end
                elseif instance:IsA("TextLabel") or instance:IsA("TextBox") then
                    local stroke = instance:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", instance)
                    stroke.Thickness = 1.2
                    stroke.Color = CHAT_BLACK
                    
                    if instance.Name:find("Name") or instance.Name:find("User") or instance.Name:find("Sender") then
                        instance.TextColor3 = CHAT_SLIGHT_PURPLE
                    else
                        instance.TextColor3 = Color3.fromRGB(235, 215, 255)
                    end
                end
                for _, child in ipairs(instance:GetChildren()) do
                    RecurseAndColorChat(child)
                end
            end
            
            RecurseAndColorChat(chatGui)
            chatGui.ChildAdded:Connect(RecurseAndColorChat)
        end
    end)
end

applyMultiToneChat()

