-- --- LOGIC ---
local active = false
local connection

local function findTarget(name)
	name = name:lower()
	for _, p in pairs(players:GetPlayers()) do
		if p ~= lp then
			if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then
				return p
			end
		end
	end
	return nil
end

local function runBang(mode)
	if connection then connection:Disconnect() end
	active = false
	
	local targetPlayer = findTarget(targetInput.Text)
	local speed = tonumber(speedInput.Text) or 20
	
	-- Počkej na novou postavu po resetu
	local character = lp.Character or lp.CharacterAdded:Wait()
	local hrp = character:WaitForChild("HumanoidRootPart")
	
	if targetPlayer and targetPlayer.Character then
		active = true
		local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
		
		connection = runService.Heartbeat:Connect(function()
			if not active or not tHrp or not tHrp.Parent or not hrp.Parent then
				if connection then connection:Disconnect() end
				return
			end
			
			local move = math.sin(tick() * speed) * 1.2
			local offset
			
			if mode == "back" then
				offset = CFrame.new(0, 0, 2.2 + move)
			elseif mode == "front" then
				offset = CFrame.new(0, 0, -2.2 - move)
			elseif mode == "head" then
				offset = CFrame.new(0, 2.0, -0.8 - move) * CFrame.Angles(0, math.rad(180), 0)
			end
			
			hrp.CFrame = tHrp.CFrame * offset
		end)
	end
end

-- Events
backBtn.MouseButton1Click:Connect(function() runBang("back") end)
frontBtn.MouseButton1Click:Connect(function() runBang("front") end)
headBtn.MouseButton1Click:Connect(function() runBang("head") end)
stopBtn.MouseButton1Click:Connect(function() active = false if connection then connection:Disconnect() end end)
