    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    
    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        CategoryContentFrame.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y + 20)
    end)

    local TabButton = Instance.new("TextButton", GlobalSidebar)
    TabButton.Size = UDim2.new(1, -10, 0, 45)
    TabButton.BackgroundColor3 = COLOR_BG
    TabButton.Text = categoryName
    applySlimTextStyle(TabButton, 15)
    
    Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 8)
    local tStroke = Instance.new("UIStroke", TabButton)
    tStroke.Color = THEME_PURPLE
    tStroke.Thickness = 1

    TabButton.MouseButton1Click:Connect(function()
        for _, frame in pairs(registeredTabs) do
            frame.Visible = false
        end
        CategoryContentFrame.Visible = true
        currentContainerFrame = CategoryContentFrame
    end)

    if not currentContainerFrame then
        CategoryContentFrame.Visible = true
        currentContainerFrame = CategoryContentFrame
    end

    table.insert(registeredTabs, CategoryContentFrame)

    local tabProxy = {}
    
    local function dummyFunction(...) end

    return setmetatable(tabProxy, {
        __call = function(_, btnName, callback)
            if type(btnName) == "string" and type(callback) == "function" then
                local scrBtn = Instance.new("TextButton", CategoryContentFrame)
                scrBtn.Size = UDim2.new(1, -10, 0, 45)
                scrBtn.BackgroundColor3 = COLOR_BG
                scrBtn.Text = btnName
                applySlimTextStyle(scrBtn, 14)
                
                Instance.new("UICorner", scrBtn).CornerRadius = UDim.new(0, 8)
                local sStroke = Instance.new("UIStroke", scrBtn)
                sStroke.Color = THEME_PURPLE
                sStroke.Thickness = 1
                
                scrBtn.MouseButton1Click:Connect(function()
                    showExecutionNotice(btnName) -- Triggers the Upper Right Notice Box frame layout update
                    callback()
                end)
                return scrBtn
            else
                return dummyFunction
            end
        end,
        __index = function()
            return dummyFunction
        end
    })
end

