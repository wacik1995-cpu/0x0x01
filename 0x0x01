        bcStroke.Color = THEME_PURPLE
        bcStroke.Thickness = 1

        boxCloseBtn.MouseButton1Click:Connect(function()
            local closeTween = TweenService:Create(GuiBox, tweenInfoQuick, {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                BackgroundTransparency = 1
            })
            closeTween:Play()
            closeTween.Completed:Connect(function()
                GuiBox.Visible = false
            end)
            openWindows[titleText] = nil
        end)
        
        -- Special rendering injector frame block if it's the dynamic Update Box window container layout
        if titleText == "UPDATES" then
            local UpdateScroller = Instance.new("ScrollingFrame", GuiBox)
            UpdateScroller.Size = UDim2.new(1, -40, 1, -70)
