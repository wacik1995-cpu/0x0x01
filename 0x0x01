    SliderLine.Name = "SliderLine"
    SliderLine.Size = UDim2.new(0, 400, 0, 6)
    SliderLine.Position = UDim2.new(0.5, -200, 0, 160)
    SliderLine.BackgroundColor3 = THEME_PURPLE
    SliderLine.BorderSizePixel = 0
    Instance.new("UICorner", SliderLine).CornerRadius = UDim.new(1, 0)

    local SliderCircle = Instance.new("TextButton", SliderLine)
    SliderCircle.Name = "SliderCircle"
    SliderCircle.Size = UDim2.new(0, 24, 0, 24)
    SliderCircle.Position = UDim2.new(globalTransparencyValue, -12, 0.5, -12)
    SliderCircle.BackgroundColor3 = THEME_PURPLE
    SliderCircle.Text = ""
    Instance.new("UICorner", SliderCircle).CornerRadius = UDim.new(1, 0)

    local scStroke = Instance.new("UIStroke", SliderCircle)
    scStroke.Color = COLOR_STROKE
    scStroke.Thickness = 1.5

    local ValueLabel = Instance.new("TextLabel", SettingsWindow)
    ValueLabel.Size = UDim2.new(0, 100, 0, 30)
    ValueLabel.Position = UDim2.new(0.5, -50, 0, 190)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = tostring(math.floor(globalTransparencyValue * 100)) .. "%"
    applySlimTextStyle(ValueLabel, 15)

    local isDragging = false
    SliderCircle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local absoluteX = SliderLine.AbsolutePosition.X
            local absoluteWidth = SliderLine.AbsoluteSize.X
            local scale = math.clamp((input.Position.X - absoluteX) / absoluteWidth, 0, 0.85)
            
            SliderCircle.Position = UDim2.new(scale, -12, 0.5, -12)
            ValueLabel.Text = tostring(math.floor(scale * 100)) .. "%"
            
            globalTransparencyValue = scale
            if MainWindowFrame then MainWindowFrame.BackgroundTransparency = scale end
            for _, frame in pairs(activeFramesForTransparency) do
                if frame and frame.Parent then
                    frame.BackgroundTransparency = scale
                end
            end
        end
    end)
end

